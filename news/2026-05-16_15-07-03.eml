images.harmony.epsilon.com/ContentHandler/images?id=3f67ada7-a01e-4c02-ab71-8b46fd3106ae" height="20" border="0" alt="" style="display: block; height: 20px; margin: 0px;"></td></tr></tbody></table></td></tr></tbody></table></div></td></tr><tr><td style="text-size-adjust: none;"><table role="presentation" bgcolor="#FFFFFF" width="640" border="0" align="center" cellpadding="0" cellspacing="0" class="gmail-wrap"><tbody><tr><td bgcolor="#FFFFFF" style="text-size-adjust: none;"><div style="text-size-adjust: none;"><table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#FFFFFF"><tbody><tr><td valign="top" align="left" style="text-size-adjust: none;"><table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0" class="gmail-wrap"><tbody><tr><td align="left" class="gmail-pad20rl gmail-match" style="padding:0px 20px 16px"><p class="gmail-mobile_match" style="font-size:14px;line-height:21px;margin:0px;letter-spacing:0px;color:rgb(51,51,51);font-family:Helvetica,Arial,sans-serif"><span style="font-size:18px;line-height:27px">Welcome to the latest edition of <em>Only McKinsey Perspectives</em>. We hope you find our insights useful. Let us know what you think at <span style="text-decoration:underline;line-height:27px"><span style="color:rgb(34,81,255);line-height:27px"><a href="https://email.mckinsey.com/T/v710000019df9a78ad2a81d35369f52aa68/59c13e503bda451c0000021ef3a0bcd6/59c13e50-3bda-451c-9089-75a6a5b50caf?__dU__=v0G4RBKTXg2GsTlMa8YbE0npiPHb7Gzq29ujr-mrJsl6bcn0E30HNSquNCCrd1XNAz" target="_blank" rel="noopener" style="color:rgb(34,81,255);font-size:inherit;font-family:inherit;font-weight:inherit;line-height:inherit">Alex_Panas@McKinsey.com</a></span></span><span style="line-height:27px"><span style="color:rgb(5,28,44);line-height:27px"> and </span></span><span style="text-decoration:underline;line-height:27px"><span style="color:rgb(34,81,255);line-height:27px"><a href="https://email.mckinsey.com/T/v710000019df9a78ad2a81d35369f52aa68/59c13e503bda451c0000021ef3a0bcd7/59c13e50-3bda-451c-9089-75a6a5b50caf?__dU__=v0G4RBKTXg2GsTlMa8YbE0npiPHb7Gzq29ujr-mrJsl6bcn0E30HNSquNCCrd1XNAz" target="_blank" rel="noopener" style="color:rgb(34,81,255);font-size:inherit;font-family:inherit;font-weight:inherit;line-height:inherit;background:none">Becca_Coggins@McKinsey.com</a></span></span>.</span></p></td></tr></tbody></table></td></tr></tbody></table></div></td></tr><tr><td bgcolor="#FFFFFF" style="text-size-adjust: none;"><div style="text-size-adjust: none;"><table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#FFFFFF"><tbody><tr><td valign="top" align="left" style="text-size-adjust: none;"><table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0" class="gmail-wrap"><tbody><tr><td align="right" class="gmail-pad20rl gmail-match" style="padding:0px 20px 36px"><p class="gmail-mobile_match" style="font-size:14px;line-height:21px;margin:0px;letter-spacing:0px;color:rgb(51,51,51);font-family:Helvetica,Arial,sans-serif"><span style="font-size:18px;line-height:27px">—Alex and Becca</span></p></td></tr></tbody></table></td></tr></tbody></table></div></td></tr></tbody></table></td></tr><tr><td style="text-size-adjust: none;"><table role="presentation" bgcolor="#FFFFFF" width="640" border="0" align="center" cellpadding="0" cellspacing="0" class="gmail-wrap"><tbody><tr><td bgcolor="#FFFFFF" style="text-size-adjust: none;"><div style="text-size-adjust: none;"><table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#FFFFFF"><tbody><tr><td valign="top" align="left" style="text-size-adjust: none;"><table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0" class="gmail-wrap"><tbody><tr><td align="left" class="gmail-pad20rl gmail-match" style="padding:0px 20px 16px"><h3 class="gmail-mobile_match" style="font-size:14px;line-height:16.8px;margin:0px;font-weight:normal;letter-spacing:0px;font-family:Helvetica,Arial,sans-serif"><span style="font-size:24px;line-height:28.8px"><strong style="font-weight:bold"><a href="https://email.mckinsey.com/industries/retail/our-insights/shopping-in-the-age-of-ai-redefining-stores-for-a-new-era?__hScId__=v710000019df9a78ad2a81d35369f52aa68&amp;__hRlId__=59c13e503bda451c0000021ef3a0bcd8&amp;__hDId__=59c13e50-3bda-451c-9089-75a6a5b50caf&amp;__hSD__=d3d3Lm1ja2luc2V5LmNvbQ==&amp;cid=mgp_opr-eml-nsl-omcknsl-mgp-glb--&amp;hlkid=fa8a593505d242d9a37a8eee56e9c25b&amp;hctky=1926&amp;hdpid=59c13e50-3bda-451c-9089-75a6a5b50caf" target="_blank" rel="noopener" style="color:rgb(0,0,0);text-decoration:none;font-size:inherit;font-family:inherit;font-weight:inherit;line-height:inherit"><span style="line-height:28.8px"><span style="font-family:Georgia,Times,serif;line-height:28.8px">From stores to experiences﻿</span></span></a></strong></span></h3></td></tr></tbody></table></td></tr></tbody></table></div></td></tr></tbody></table></td></tr><tr><td bgcolor="#FFFFFF" style="text-size-adjust: none;"><div style="text-size-adjust: none;"><table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#FFFFFF"><tbody><tr><td valign="top" align="left" style="text-size-adjust: none;"><table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0" class="gmail-wrap"><tbody><tr><td align="left" class="gmail-pad20rl gmail-match" style="padding:0px 20px 16px"><p class="gmail-mobile_match" style="font-size:14px;line-height:21px;margin:0px;letter-spacing:0px;color:rgb(51,51,51);font-family:Helvetica,Arial,sans-serif"><span style="font-size:16px;line-height:24px"><strong style="font-weight:bold">In the news.</strong> <em>Fast Company</em> reports that physical retail is shifting toward experience as the primary competitive lever, with emotionally connected customers spending up to 140% more. Stores are evolving beyond points of sale into hubs for discovery, guidance, and community. With personalization now a baseline, retailers are deploying in-store AI tools—such as conversational assistants that help shoppers find and choose products—to build trust. Brands are also designing stores around fandoms and shared cultural identities, using events, exclusive drops, and creator-led experiences to drive engagement and repeat visits. <span style="text-decoration:underline;line-height:24px">[</span><a href="https://email.mckinsey.com/T/v710000019df9a78ad2a81d35369f52aa68/59c13e503bda451c0000021ef3a0bcd9/59c13e50-3bda-451c-9089-75a6a5b50caf?__dU__=v0G4RBKTXg2GsTlMa8YbE0npiPHb7Gzq29ujr-mrJsl6bcn0E30HNSquNCCrd1XNAz" target="_blank" rel="noopener" style="color:rgb(51,51,51);text-decoration:none;font-size:inherit;font-family:inherit;font-weight:inherit;line-height:inherit;background:none"><span style="color:rgb(34,81,255);text-decoration:underline;line-height:24px">Fast Company</span></a><span style="text-decoration:underline;line-height:24px">]</span></span></p></td></tr></tbody></table></td></tr></tbody></table></div></td></tr><tr><td bgcolor="#FFFFFF" style="text-size-adjust: none;"><div style="text-size-adjust: none;"><table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#FFFFFF"><tbody><tr><td align="center" valign="top" class="gmail-pad20rl" style="text-size-adjust: none;"><table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#FFFFFF" class="gmail-wrap"><tbody><tr><td align="center" valign="top" class="gmail-pad20rl" style="padding:0px 20px 20px"><table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#000000" class="gmail-wrap"><tbody><tr><td align="center" valign="top" style="line-height:1px"><img src="https://images.harmony.epsilon.com/ContentHandler/images?id=3f67ada7-a01e-4c02-ab71-8b46fd3106ae" height="1" border="0" alt="" style="display: block; margin: 0px;"></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table></div></td></tr><tr><td bgcolor="#FFFFFF" style="text-size-adjust: none;"><div style="text-size-adjust: none;"><table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#FFFFFF"><tbody><tr><td valign="top" align="left" style="text-size-adjust: none;"><table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0" class="gmail-wrap"><tbody><tr><td align="center" class="gmail-pad20rl gmail-match" style="padding:0px 20px 20px"><h2 class="gmail-mobile_match" style="font-size:14px;line-height:16.8px;margin:0px;font-weight:normal;letter-spacing:0px;font-family:Georgia,Cambria,Times,&quot;Times New Roman&quot;,serif"><span style="font-size:26px;line-height:31.2px">Convenience-driven consumers often know what they want to buy before they leave home. ... Once they’re in the store, they seek an easy experience and product availability.</span></h2></td></tr></tbody></table></td></tr></tbody></table></div></td></tr><tr><td bgcolor="#FFFFFF" style="text-size-adjust: none;"><div style="text-size-adjust: none;"><table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#FFFFFF"><tbody><tr><td align="center" valign="top" class="gmail-pad20rl" style="text-size-adjust: none;"><table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#FFFFFF" class="gmail-wrap"><tbody><tr><td align="center" valign="top" class="gmail-pad20rl" style="padding:0px 20px 20px"><table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#000000" class="gmail-wrap"><tbody><tr><td align="center" valign="top" style="line-height:1px"><img src="https://images.harmony.epsilon.com/ContentHandler/images?id=3f67ada7-a01e-4c02-ab71-8b46fd3106ae" height="1" border="0" alt="" style="display: block; margin: 0px;"></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table></div></td></tr><tr><td bgcolor="#FFFFFF" style="text-size-adjust: none;"><div style="text-size-adjust: none;"><table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#FFFFFF"><tbody><tr><td valign="top" align="left" style="text-size-adjust: none;"><table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0" class="gmail-wrap"><tbody><tr><td align="left" class="gmail-pad20rl gmail-match" style="padding:0px 20px 16px"><p class="gmail-mobile_match" style="font-size:14px;line-height:21px;margin:0px;letter-spacing:0px;color:rgb(51,51,51);font-family:Helvetica,Arial,sans-serif"><span style="font-size:16px;line-height:24px"><strong style="font-weight:bold">On McKinsey.com.</strong> AI is redefining the role of physical stores, turning them into <span style="text-decoration:underline;line-height:24px;color:rgb(34,81,255)"><a href="https://email.mckinsey.com/industries/retail/our-insights/shopping-in-the-age-of-ai-redefining-stores-for-a-new-era?__hScId__=v710000019df9a78ad2a81d35369f52aa68&amp;__hRlId__=59c13e503bda451c0000021ef3a0bcda&amp;__hDId__=59c13e50-3bda-451c-9089-75a6a5b50caf&amp;__hSD__=d3d3Lm1ja2luc2V5LmNvbQ==&amp;cid=mgp_opr-eml-nsl-omcknsl-mgp-glb--&amp;hlkid=a08a83604e19474fa506cca78c1bd70f&amp;hctky=1926&amp;hdpid=59c13e50-3bda-451c-9089-75a6a5b50caf" target="_blank" rel="noopener" style="color:rgb(34,81,255);font-size:inherit;font-family:inherit;font-weight:inherit;line-height:inherit;background:none">adaptive, hyperpersonalized environments</a></span> that integrate seamlessly with digital channels. McKinsey’s <span style="text-decoration:underline;line-height:24px;color:rgb(34,81,255)"><a href="https://email.mckinsey.com/T/v710000019df9a78ad2a81d35369f52aa68/59c13e503bda451c0000021ef3a0bcdb/59c13e50-3bda-451c-9089-75a6a5b50caf?__dU__=v0G4RBKTXg2GsTlMa8YbE0npiPHb7Gzq29ujr-mrJsl6bcn0E30HNSquNCCrd1XNAz" target="_blank" rel="noopener" style="color:rgb(34,81,255);font-size:inherit;font-family:inherit;font-weight:inherit;line-height:inherit;background:none">Colleen Baum</a></span>, Molly Squire, Tyler Rose, and Joshua Reuben highlight how leading retailers are using advanced analytics and generative AI to optimize assortment, tailor promotions and recommendations, and equip store associates with real-time customer and inventory data. The opportunity is significant: By 2030, US B2C retail could see up to $1 trillion in agentic commerce revenue, with global projections reaching $3 trillion to $5 trillion. Retailers that embrace this shift can unlock growth, efficiency, and loyalty.<br><br><a href="https://email.mckinsey.com/industries/retail/our-insights/shopping-in-the-age-of-ai-redefining-stores-for-a-new-era?__hScId__=v710000019df9a78ad2a81d35369f52aa68&amp;__hRlId__=59c13e503bda451c0000021ef3a0bcdc&amp;__hDId__=59c13e50-3bda-451c-9089-75a6a5b50caf&amp;__hSD__=d3d3Lm1ja2luc2V5LmNvbQ==&amp;cid=mgp_opr-eml-nsl-omcknsl-mgp-glb--&amp;hlkid=3ef7ba5bd86f431884b1dcbe374ce5aa&amp;hctky=1926&amp;hdpid=59c13e50-3bda-451c-9089-75a6a5b50caf" target="_blank" rel="noopener" style="color:rgb(51,51,51);text-decoration:none;font-size:inherit;font-family:inherit;font-weight:inherit;line-height:inherit;background:none"><strong style="font-weight:bold"><span style="text-decoration:underline;line-height:24px"><span style="color:rgb(34,81,255);line-height:24px">Reimagine stores with AI insights<img src="https://images.harmony.epsilon.com/ContentHandler/images?id=cd761513-936e-4a05-8196-6fb668e6a87c" width="20" alt="" style="margin: 0px;"></span></span></strong></a></span></p></td></tr></tbody></table></td></tr></tbody></table></div></td></tr><tr><td bgcolor="#FFFFFF" style="text-size-adjust: none;"><div style="text-size-adjust: none;"><table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#FFFFFF"><tbody><tr><td align="center" valign="top" class="gmail-pad20rl" style="text-size-adjust: none;"><table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#FFFFFF" class="gmail-wrap"><tbody><tr><td align="center" valign="top" class="gmail-pad20rl" style="padding:0px 20px 20px"><table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#000000" class="gmail-wrap"><tbody><tr><td align="center" valign="top" style="line-height:1px"><img src="https://images.harmony.epsilon.com/ContentHandler/images?id=3f67ada7-a01e-4c02-ab71-8b46fd3106ae" height="1" border="0" alt="" style="display: block; margin: 0px;"></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table></div></td></tr><tr><td style="text-size-adjust: none;"><table role="presentation" bgcolor="#FFFFFF" width="640" border="0" align="center" cellpadding="0" cellspacing="0" class="gmail-wrap"><tbody><tr><td bgcolor="#FFFFFF" style="text-size-adjust: none;"><div style="text-size-adjust: none;"><table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#FFFFFF"><tbody><tr><td valign="top" align="left" style="text-size-adjust: none;"><table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0" class="gmail-wrap"><tbody><tr><td align="left" class="gmail-pad20rl gmail-match" style="padding:0px 20px 16px"><h3 class="gmail-mobile_match" style="font-size:14px;line-height:16.8px;margin:0px;font-weight:normal;letter-spacing:0px;font-family:Helvetica,Arial,sans-serif"><strong style="font-weight:bold"><span style="font-size:18px;line-height:21.6px"><span style="font-size:24px;line-height:28.8px"><strong style="font-weight:bold"><span style="font-family:Georgia,Times,serif;line-height:28.8px"><span style="line-height:28.8px"><a href="https://email.mckinsey.com/mhi/our-insights/the-future-is-shared-financing-task-sharing-programs-in-mental-health?__hScId__=v710000019df9a78ad2a81d35369f52aa68&amp;__hRlId__=59c13e503bda451c0000021ef3a0bcdd&amp;__hDId__=59c13e50-3bda-451c-9089-75a6a5b50caf&amp;__hSD__=d3d3Lm1ja2luc2V5LmNvbQ==&amp;cid=mgp_opr-eml-nsl-omcknsl-mgp-glb--&amp;hlkid=5c28505f415f4779a6152a4bd8258be1&amp;hctky=1926&amp;hdpid=59c13e50-3bda-451c-9089-75a6a5b50caf" target="_blank" rel="noopener" style="color:rgb(0,0,0);text-decoration:none;font-size:inherit;font-family:inherit;font-weight:inherit;line-height:inherit;background:none">Rising healthcare cost pressure﻿</a></span></span></strong></span><br></span></strong></h3></td></tr></tbody></table></td></tr></tbody></table></div></td></tr></tbody></table></td></tr><tr><td bgcolor="#FFFFFF" style="text-size-adjust: none;"><div style="text-size-adjust: none;"><table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#FFFFFF"><tbody><tr><td valign="top" align="left" style="text-size-adjust: none;"><table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0" class="gmail-wrap"><tbody><tr><td align="left" class="gmail-pad20rl gmail-match" style="padding:0px 20px 16px"><p class="gmail-mobile_match" style="font-size:14px;line-height:21px;margin:0px;letter-spacing:0px;color:rgb(51,51,51);font-family:Helvetica,Arial,sans-serif"><span style="font-size:16px;line-height:24px"><strong style="font-weight:bold">In the news.</strong> The largest increase in healthcare costs in over a decade is pushing CFOs toward more aggressive action. According to <em>The Wall Street Journal</em>, costs are expected to rise by about 9.5% this year, and executives are raising employee premiums, redesigning plans, and exploring self-insurance models where employers pay medical claims directly rather than relying on insurers. Traditional levers offer only limited relief, forcing companies to consider more structural changes as underlying cost pressures persist. As a result, costs are increasingly being shared with employees or offset through trade-offs in wages and benefits. [<a href="https://email.mckinsey.com/T/v710000019df9a78ad2a81d35369f52aa68/59c13e503bda451c0000021ef3a0bcde/59c13e50-3bda-451c-9089-75a6a5b50caf?__dU__=v0G4RBKTXg2GsTlMa8YbE0npiPHb7Gzq29ujr-mrJsl6bcn0E30HNSquNCCrd1XNAz" target="_blank" rel="noopener" style="color:rgb(51,51,51);text-decoration:none;font-size:inherit;font-family:inherit;font-weight:inherit;line-height:inherit;background:none"><span style="text-decoration:underline;line-height:24px;color:rgb(34,81,255)">WSJ</span></a>]<br><br><strong style="font-weight:bold">On McKinsey.com.</strong> With mental healthcare funding under pressure, expanding access may require broadening who delivers care. New research from the McKinsey Health Institute highlights <span style="text-decoration:underline;line-height:24px;color:rgb(34,81,255)"><a href="https://email.mckinsey.com/mhi/our-insights/the-future-is-shared-financing-task-sharing-programs-in-mental-health?__hScId__=v710000019df9a78ad2a81d35369f52aa68&amp;__hRlId__=59c13e503bda451c0000021ef3a0bcdf&amp;__hDId__=59c13e50-3bda-451c-9089-75a6a5b50caf&amp;__hSD__=d3d3Lm1ja2luc2V5LmNvbQ==&amp;cid=mgp_opr-eml-nsl-omcknsl-mgp-glb--&amp;hlkid=2c2a89f9bd0a4bbea4904073cb00c2c2&amp;hctky=1926&amp;hdpid=59c13e50-3bda-451c-9089-75a6a5b50caf" target="_blank" rel="noopener" style="color:rgb(34,81,255);font-size:inherit;font-family:inherit;font-weight:inherit;line-height:inherit;background:none">task-sharing programs</a></span>, which redistribute certain clinical responsibilities to trained nonspecialists to ease cost and capacity constraints. Despite mental disorders accounting for roughly 15% of the global disease burden, they receive just 2% of health budgets. McKinsey’s <span style="text-decoration:underline;line-height:24px;color:rgb(34,81,255)"><a href="https://email.mckinsey.com/T/v710000019df9a78ad2a81d35369f52aa68/59c13e503bda451c0000021ef3a0bce0/59c13e50-3bda-451c-9089-75a6a5b50caf?__dU__=v0G4RBKTXg2GsTlMa8YbE0npiPHb7Gzq29ujr-mrJsl6bcn0E30HNSquNCCrd1XNAz" target="_blank" rel="noopener" style="color:rgb(34,81,255);font-size:inherit;font-family:inherit;font-weight:inherit;line-height:inherit;background:none">Erica Coe</a></span>, <span style="text-decoration:underline;line-height:24px;color:rgb(34,81,255)"><a href="https://email.mckinsey.com/T/v710000019df9a78ad2a81d35369f52aa68/59c13e503bda451c0000021ef3a0bce1/59c13e50-3bda-451c-9089-75a6a5b50caf?__dU__=v0G4RBKTXg2GsTlMa8YbE0npiPHb7Gzq29ujr-mrJsl6bcn0E30HNSquNCCrd1XNAz" target="_blank" rel="noopener" style="color:rgb(34,81,255);font-size:inherit;font-family:inherit;font-weight:inherit;line-height:inherit;background:none">Javier Valenzuela</a></span>, <span style="text-decoration:underline;line-height:24px;color:rgb(34,81,255)"><a href="https://email.mckinsey.com/T/v710000019df9a78ad2a81d35369f52aa68/59c13e503bda451c0000021ef3a0bce2/59c13e50-3bda-451c-9089-75a6a5b50caf?__dU__=v0G4RBKTXg2GsTlMa8YbE0npiPHb7Gzq29ujr-mrJsl6bcn0E30HNSquNCCrd1XNAz" target="_blank" rel="noopener" style="color:rgb(34,81,255);font-size:inherit;font-family:inherit;font-weight:inherit;line-height:inherit;background:none">Kana Enomoto</a></span>, and Clara Gianola outline how scaling these models could address provider shortages, reduce bottlenecks, and improve outcomes at lower cost if supported by sustainable financing, clear care pathways, and appropriate oversight.<br><br>﻿<a href="https://email.mckinsey.com/mhi/our-insights/the-future-is-shared-financing-task-sharing-programs-in-mental-health?__hScId__=v710000019df9a78ad2a81d35369f52aa68&amp;__hRlId__=59c13e503bda451c0000021ef3a0bce3&amp;__hDId__=59c13e50-3bda-451c-9089-75a6a5b50caf&amp;__hSD__=d3d3Lm1ja2luc2V5LmNvbQ==&amp;cid=mgp_opr-eml-nsl-omcknsl-mgp-glb--&amp;hlkid=490ac90a55d04918a31b170218a8e79f&amp;hctky=1926&amp;hdpid=59c13e50-3bda-451c-9089-75a6a5b50caf" target="_blank" rel="noopener" style="color:rgb(51,51,51);text-decoration:none;font-size:inherit;font-family:inherit;font-weight:inherit;line-height:inherit;background:none"><strong style="font-weight:bold"><span style="line-height:24px"><span style="text-decoration:underline;line-height:24px"><span style="color:rgb(34,81,255);line-height:24px">Explore new care delivery models</span></span><img src="https://images.harmony.epsilon.com/ContentHandler/images?id=cd761513-936e-4a05-8196-6fb668e6a87c" width="20" alt="" style="margin: 0px;"></span></strong></a></span></p></td></tr></tbody></table></td></tr></tbody></table></div></td></tr><tr><td bgcolor="#FFFFFF" style="text-size-adjust: none;"><div style="text-size-adjust: none;"><table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#FFFFFF"><tbody><tr><td align="center" valign="top" class="gmail-pad20rl" style="text-size-adjust: none;"><table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#FFFFFF" class="gmail-wrap"><tbody><tr><td align="center" valign="top" class="gmail-pad20rl" style="padding:0px 20px 20px"><table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#000000" class="gmail-wrap"><tbody><tr><td align="center" valign="top" style="line-height:1px"><img src="https://images.harmony.epsilon.com/ContentHandler/images?id=3f67ada7-a01e-4c02-ab71-8b46fd3106ae" height="1" border="0" alt="" style="display: block; margin: 0px;"></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table></div></td></tr><tr><td bgcolor="#FFFFFF" style="text-size-adjust: none;"><div style="text-size-adjust: none;"><table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#FFFFFF"><tbody><tr><td valign="top" align="left" style="text-size-adjust: none;"><table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0" class="gmail-wrap"><tbody><tr><td align="left" class="gmail-pad20rl gmail-match" style="padding:0px 20px 16px"><h3 class="gmail-mobile_match" style="font-size:14px;line-height:16.8px;margin:0px;font-weight:normal;letter-spacing:0px;font-family:Helvetica,Arial,sans-serif"><strong style="font-weight:bold"><span style="font-size:18px;line-height:21.6px"><span style="font-size:24px;line-height:28.8px"><strong style="font-weight:bold"><span style="font-family:Georgia,Times,serif;line-height:28.8px"><a href="https://email.mckinsey.com/capabilities/mckinsey-technology/our-insights/reimagining-tech-infrastructure-for-and-with-agentic-ai?__hScId__=v710000019df9a78ad2a81d35369f52aa68&amp;__hRlId__=59c13e503bda451c0000021ef3a0bce4&amp;__hDId__=59c13e50-3bda-451c-9089-75a6a5b50caf&amp;__hSD__=d3d3Lm1ja2luc2V5LmNvbQ==&amp;cid=mgp_opr-eml-nsl-omcknsl-mgp-glb--&amp;hlkid=66ffdae0c9f24089a20b04b57df53149&amp;hctky=1926&amp;hdpid=59c13e50-3bda-451c-9089-75a6a5b50caf" target="_blank" rel="noopener" style="color:rgb(0,0,0);text-decoration:none;font-size:inherit;font-family:inherit;font-weight:inherit;line-height:inherit;background:none">Agentic AI infrastructure shift</a></span></strong></span><br></span></strong></h3></td></tr></tbody></table></td></tr></tbody></table></div></td></tr><tr><td bgcolor="#FFFFFF" style="text-size-adjust: none;"><div style="text-size-adjust: none;"><table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#FFFFFF"><tbody><tr><td valign="top" align="left" style="text-size-adjust: none;"><table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0" class="gmail-wrap"><tbody><tr><td align="left" class="gmail-pad20rl gmail-match" style="padding:0px 20px 16px"><p class="gmail-mobile_match" style="font-size:14px;line-height:21px;margin:0px;letter-spacing:0px;color:rgb(51,51,51);font-family:Helvetica,Arial,sans-serif"><span style="font-size:16px;line-height:24px"><strong style="font-weight:bold">In the news.</strong> According to <em>The New York Times</em>, AI coding tools are creating a “code overload,” with software output rising faster than organizations can manage. One company increased monthly output tenfold, generating a backlog of code that requires review and testing. While productivity gains are significant, the strain on engineering, security, and oversight functions is growing. With nonengineers now able to generate applications, demand for experienced reviewers is surging, and new risks are emerging. The challenge is shifting from generating code to managing it at scale, ensuring quality, security, and accountability across the organization. [<a href="https://email.mckinsey.com/T/v710000019df9a78ad2a81d35369f52aa68/59c13e503bda451c0000021ef3a0bce5/59c13e50-3bda-451c-9089-75a6a5b50caf?__dU__=v0G4RBKTXg2GsTlMa8YbE0npiPHb7Gzq29ujr-mrJsl6bcn0E30HNSquNCCrd1XNAz" target="_blank" rel="noopener" style="color:rgb(51,51,51);text-decoration:none;font-size:inherit;font-family:inherit;font-weight:inherit;line-height:inherit;background:none"><span style="text-decoration:underline;line-height:24px"><span style="color:rgb(34,81,255);line-height:24px">NYT</span></span></a>]<br><br><strong style="font-weight:bold">On McKinsey.com.</strong> A shift to more flexible, <span style="text-decoration:underline;line-height:24px;color:rgb(34,81,255)"><a href="https://email.mckinsey.com/capabilities/mckinsey-technology/our-insights/reimagining-tech-infrastructure-for-and-with-agentic-ai?__hScId__=v710000019df9a78ad2a81d35369f52aa68&amp;__hRlId__=59c13e503bda451c0000021ef3a0bce6&amp;__hDId__=59c13e50-3bda-451c-9089-75a6a5b50caf&amp;__hSD__=d3d3Lm1ja2luc2V5LmNvbQ==&amp;cid=mgp_opr-eml-nsl-omcknsl-mgp-glb--&amp;hlkid=1b53f72649344ab8981013f69f283d9f&amp;hctky=1926&amp;hdpid=59c13e50-3bda-451c-9089-75a6a5b50caf" target="_blank" rel="noopener" style="color:rgb(34,81,255);font-size:inherit;font-family:inherit;font-weight:inherit;line-height:inherit;background:none">“mesh-like” architectures</a></span> could enable AI agents and tools to collaborate reliably across enterprise workflows. Rather than layering AI onto legacy systems, this approach redefines IT infrastructure as an active enabler of how work gets done. As agentic AI scales, infrastructure must evolve to support coordination, reliability, and speed across systems. McKinsey’s Arnaud Tournesac, <span style="text-decoration:underline;line-height:24px;color:rgb(34,81,255)"><a href="https://email.mckinsey.com/T/v710000019df9a78ad2a81d35369f52aa68/59c13e503bda451c0000021ef3a0bce7/59c13e50-3bda-451c-9089-75a6a5b50caf?__dU__=v0G4RBKTXg2GsTlMa8YbE0npiPHb7Gzq29ujr-mrJsl6bcn0E30HNSquNCCrd1XNAz" target="_blank" rel="noopener" style="color:rgb(34,81,255);font-size:inherit;font-family:inherit;font-weight:inherit;line-height:inherit;background:none">Arun Gundurao</a></span>, <span style="text-decoration:underline;line-height:24px;color:rgb(34,81,255)"><a href="https://email.mckinsey.com/T/v710000019df9a78ad2a81d35369f52aa68/59c13e503bda451c0000021ef3a0bce8/59c13e50-3bda-451c-9089-75a6a5b50caf?__dU__=v0G4RBKTXg2GsTlMa8YbE0npiPHb7Gzq29ujr-mrJsl6bcn0E30HNSquNCCrd1XNAz" target="_blank" rel="noopener" style="color:rgb(34,81,255);font-size:inherit;font-family:inherit;font-weight:inherit;line-height:inherit;background:none">Ling Lau</a></span>, and <span style="text-decoration:underline;line-height:24px;color:rgb(34,81,255)"><a href="https://email.mckinsey.com/T/v710000019df9a78ad2a81d35369f52aa68/59c13e503bda451c0000021ef3a0bce9/59c13e50-3bda-451c-9089-75a6a5b50caf?__dU__=v0G4RBKTXg2GsTlMa8YbE0npiPHb7Gzq29ujr-mrJsl6bcn0E30HNSquNCCrd1XNAz" target="_blank" rel="noopener" style="color:rgb(34,81,255);font-size:inherit;font-family:inherit;font-weight:inherit;line-height:inherit;background:none">Pankaj Sachdeva</a></span> explain how this shift gives C-suite leaders an opportunity to redesign technology foundations and fundamentally change how work is executed.<br><br>﻿<a href="https://email.mckinsey.com/capabilities/mckinsey-technology/our-insights/reimagining-tech-infrastructure-for-and-with-agentic-ai?__hScId__=v710000019df9a78ad2a81d35369f52aa68&amp;__hRlId__=59c13e503bda451c0000021ef3a0bcea&amp;__hDId__=59c13e50-3bda-451c-9089-75a6a5b50caf&amp;__hSD__=d3d3Lm1ja2luc2V5LmNvbQ==&amp;cid=mgp_opr-eml-nsl-omcknsl-mgp-glb--&amp;hlkid=4f31fe4a91b14f0498e2b667e393824c&amp;hctky=1926&amp;hdpid=59c13e50-3bda-451c-9089-75a6a5b50caf" target="_blank" rel="noopener" style="color:rgb(51,51,51);text-decoration:none;font-size: